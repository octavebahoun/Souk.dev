# Routes de la plateforme en production : front, API et Reverb derrière Traefik.
# Modèle : le service « init » le copie dans le dossier des routes au démarrage, avec le
# domaine et les ports remplis (__DOMAINE__, __PORT_API__…), et sans les blocs « tls » quand un
# proxy placé devant Traefik termine déjà le TLS (MOTEUR_TLS_TRAEFIK=false). Les copies ont leurs propres fichiers
# dans le même dossier, écrits par App\Moteur\RouteurCopies.
http:
  routers:
    front:
      rule: "Host(`__DOMAINE__`)"
      entryPoints: [websecure]
      service: front
      # La CSP du front, qui autorise ses scripts par empreinte, vient de nginx (frontend/nginx.conf).
      middlewares: [securite, compression]
      tls:
        certResolver: letsencrypt
    api:
      rule: "Host(`api.__DOMAINE__`)"
      entryPoints: [websecure]
      service: api
      middlewares: [securite, csp-api, compression]
      tls:
        certResolver: letsencrypt
    # Captures des applis : gardées un jour par le navigateur (une capture remplacée garde son nom).
    captures:
      rule: "Host(`api.__DOMAINE__`) && PathPrefix(`/storage/captures/`)"
      entryPoints: [websecure]
      service: api
      middlewares: [securite, cache-captures]
      tls:
        certResolver: letsencrypt
    reverb:
      rule: "Host(`reverb.__DOMAINE__`)"
      entryPoints: [websecure]
      service: reverb
      middlewares: [securite]
      tls:
        certResolver: letsencrypt

  middlewares:
    # Réponses texte compressées (JSON de l'API, pages du front) ; les images et le temps réel
    # ne sont pas concernés.
    compression:
      compress:
        excludedContentTypes: [text/event-stream]
    # HTTPS imposé un an (sous-domaines compris : api, reverb), pas de devinette de type, jamais
    # affiché dans le cadre d'un autre site (détournement de clic sur « Recevoir mon solde »…).
    securite:
      headers:
        stsSeconds: 31536000
        stsIncludeSubdomains: true
        stsPreload: true
        contentTypeNosniff: true
        frameDeny: true
        referrerPolicy: strict-origin-when-cross-origin
        permissionsPolicy: "camera=(), microphone=(), geolocation=(), payment=()"
    cache-captures:
      headers:
        customResponseHeaders:
          Cache-Control: "public, max-age=86400"
    # L'API ne sert que du JSON et quelques pages sans script (lien magique, confirmation d'un
    # numéro). Leurs formulaires renvoient ensuite vers le front : form-action doit l'autoriser,
    # les navigateurs l'appliquent aussi à la redirection qui suit l'envoi.
    csp-api:
      headers:
        contentSecurityPolicy: "default-src 'none'; style-src 'unsafe-inline'; img-src 'self' data:; form-action 'self' https://__DOMAINE__; frame-ancestors 'none'; base-uri 'none'"

  services:
    # Traefik est sur le réseau de l'hôte : il joint les ports publiés sur la boucle locale.
    front:
      loadBalancer:
        servers:
          - url: "http://127.0.0.1:__PORT_FRONT__"
    api:
      loadBalancer:
        servers:
          - url: "http://127.0.0.1:__PORT_API__"
    reverb:
      loadBalancer:
        servers:
          - url: "http://127.0.0.1:__PORT_REVERB__"
