# Souk.dev en production : copier en backend/.env.prod (jamais commité) et remplir.
# Puis : ./scripts/prod.sh up -d (voir docs/exploitation.md).
# Les secrets internes (PostgreSQL, Reverb) sont générés dans le volume « secrets » ;
# tout ce qui est ici, ce sont les clés externes et les réglages de l'opérateur.

# --- Domaine et certificats -------------------------------------------------
# Domaine racine : front https://$DOMAINE, API https://api.$DOMAINE,
# Reverb wss://reverb.$DOMAINE.
DOMAINE=
# Domaine des copies, à part (ex. souk-apps.net) : https://{copie}.$DOMAINE_COPIES.
# Jamais un sous-domaine de $DOMAINE : les copies font tourner le code de leurs auteurs et
# recevraient le cookie de session des membres (l'API refuse alors de servir : erreur 500 sur
# chaque requête, la cause dans les journaux).
DOMAINE_COPIES=
# Compte Let's Encrypt : reçoit les alertes d'expiration des certificats.
ACME_EMAIL=

# --- Derrière un proxy existant (serveur partagé) ---------------------------
# false quand un autre proxy (Caddy…) garde déjà les ports 80 et 443 et termine le TLS : Traefik
# passe derrière lui, en HTTP, et ./scripts/prod.sh ajoute docker-compose.derriere-proxy.yml.
# Voir docs/exploitation.md, « Derrière un proxy existant ». ACME_EMAIL reste obligatoire.
MOTEUR_TLS_TRAEFIK=true
# Ports de la plateforme sur la boucle locale du serveur, à changer s'ils sont déjà pris.
# PORT_API=8000
# PORT_REVERB=8080
# PORT_FRONT=8081

# --- Application ------------------------------------------------------------
# Générée une fois, sur le VPS (Laravel ne démarre pas encore sans les secrets internes) :
#   echo "APP_KEY=base64:$(openssl rand -base64 32)" >> backend/.env.prod
APP_KEY=
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

# --- E-mails (Resend) -------------------------------------------------------
RESEND_API_KEY=
MAIL_FROM_ADDRESS="bonjour@souk.dev"
MAIL_FROM_NAME="Souk.dev"
# Adresse de contact affichée sur le site (mentions légales, confidentialité, security.txt).
# Vide : souk@send.excellenceteam.site. Lue au build du front (docker-compose.prod.yml).
CONTACT_EMAIL=
# Alertes de l'équipe (argent, exploitation, modération grave). Vide : MAIL_FROM_ADDRESS.
ADMIN_EMAIL=

# --- Paiement (SasPay) ------------------------------------------------------
SASPAY_SECRET_KEY=
SASPAY_WEBHOOK_SECRET=
# Passerelle d'encaissement : toujours saspay en production (le simulateur y est refusé).
# Les reversements restent simulés tant que REVERSEMENTS_REELS vaut false ; true seulement
# quand l'IP du VPS est en liste blanche chez SasPay.
REVERSEMENTS_REELS=false

# --- Souk AI (DeepSeek) -----------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_MODELE=deepseek-flash

# --- Connexion GitHub des devs ----------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://api.soukdev.example/auth/github/callback

# --- SMS (connexion des utilisateurs finaux) ---------------------------------
# Vides : fournisseur simulé (les codes partent quand même par e-mail).
SMS_PROVIDER=
SMS_API_KEY=

# --- Journaux ---------------------------------------------------------------
# Canal « json » (voir config/logging.php) ; niveau : debug, info, warning, error.
LOG_LEVEL=info
