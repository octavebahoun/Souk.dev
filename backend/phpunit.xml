<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="APP_URL" value="http://localhost:8000" force="true"/>
        <env name="FRONTEND_URL" value="http://localhost:5173" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="GITHUB_CLIENT_ID" value="valeur-de-test" force="true"/>
        <env name="GITHUB_CLIENT_SECRET" value="valeur-de-test" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="IA_FOURNISSEUR" value="simulee" force="true"/>
        <env name="DEMO_CONNEXION" value="false" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="REVERB_APP_KEY" value="valeur-de-test" force="true"/>
        <env name="REVERB_APP_SECRET" value="valeur-de-test" force="true"/>
        <env name="REVERB_APP_ID" value="soukdev" force="true"/>
        <!-- Jamais la vraie API SasPay dans les tests (la clé de backend/.env est une clé de production). -->
        <env name="PAIEMENT_PASSERELLE" value="simulee" force="true"/>
        <env name="SASPAY_SECRET_KEY" value="" force="true"/>
        <env name="SASPAY_WEBHOOK_SECRET" value="secret-webhook-de-test" force="true"/>
        <env name="SASPAY_BASE_URL" value="https://saspay.test/api/v1" force="true"/>
        <env name="REVERSEMENTS_REELS" value="false" force="true"/>
        <env name="SIMULATEUR_WEBHOOK_URL" value="http://localhost:8000/api/webhooks/saspay" force="true"/>
        <env name="ADMIN_EMAIL" value="admin@exemple.test" force="true"/>
        <env name="MOTEUR_DELAI_PROXY" value="0" force="true"/>
        <server name="PAIEMENT_PASSERELLE" value="simulee"/>
        <server name="SASPAY_SECRET_KEY" value=""/>
        <server name="SASPAY_WEBHOOK_SECRET" value="secret-webhook-de-test"/>
        <server name="SASPAY_BASE_URL" value="https://saspay.test/api/v1"/>
        <server name="REVERSEMENTS_REELS" value="false"/>
        <server name="SIMULATEUR_WEBHOOK_URL" value="http://localhost:8000/api/webhooks/saspay"/>
        <server name="ADMIN_EMAIL" value="admin@exemple.test"/>
        <server name="IA_FOURNISSEUR" value="simulee"/>
        <server name="DEEPSEEK_API_KEY" value=""/>
        <server name="MOTEUR_DELAI_PROXY" value="0"/>
        <server name="BROADCAST_CONNECTION" value="null"/>
        <server name="DEMO_CONNEXION" value="false"/>
        <server name="CACHE_STORE" value="array"/>
        <server name="DB_CONNECTION" value="sqlite"/>
        <server name="DB_DATABASE" value=":memory:"/>
        <server name="SESSION_DRIVER" value="array"/>
        <server name="QUEUE_CONNECTION" value="sync"/>
        <server name="REVERB_APP_KEY" value="valeur-de-test"/>
        <server name="REVERB_APP_SECRET" value="valeur-de-test"/>
        <server name="REVERB_APP_ID" value="soukdev"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
