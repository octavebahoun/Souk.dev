# Souk.dev — variables du backend. Copier en .env (jamais commité).
# Avec docker compose, la plateforme surcharge la base, la file, le cache et Reverb
# (voir docker-compose.yml) et génère ses secrets internes dans le volume « secrets ».

# --- Application ------------------------------------------------------------
APP_NAME="Souk.dev"
APP_ENV=local
# Générée par `php artisan key:generate` (ou par le service init de docker compose).
APP_KEY=
APP_DEBUG=true
# URL publique de l'API et du front. Toujours localhost en dev, jamais 127.0.0.1 (la session casse).
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Connexion aux comptes du jeu de démo (POST /auth/demo) : développement et tests seulement.
# Toujours refusée en production. Jeu de démo : php artisan db:seed --class=DemoSeeder
DEMO_CONNEXION=false

# --- Journaux ---------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de données --------------------------------------------------------
# SQLite en dev local sans Docker ; PostgreSQL avec docker compose et en production.
DB_CONNECTION=sqlite
# DB_HOST=db
# DB_PORT=5432
# DB_DATABASE=soukdev
# DB_USERNAME=soukdev
# DB_PASSWORD=

# --- Session et authentification SPA (Sanctum) ------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=soukdev_session
SANCTUM_STATEFUL_DOMAINS=localhost:5173

# Connexion des devs par GitHub (OAuth App, dépôts publics seulement).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5173/auth/github/callback

# --- Temps réel (Reverb) ----------------------------------------------------
BROADCAST_CONNECTION=reverb
# Générés par docker compose ; à remplir à la main sans Docker (valeurs aléatoires).
REVERB_APP_ID=soukdev
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
# Hôtes autorisés à ouvrir un WebSocket, séparés par des virgules (celui de FRONTEND_URL par défaut).
# REVERB_ALLOWED_ORIGINS=localhost

# --- Files d'attente, cache, fichiers ----------------------------------------
QUEUE_CONNECTION=database
# Délai avant qu'un job réservé soit repris : plus long que le plus long déploiement.
DB_QUEUE_RETRY_AFTER=1260
CACHE_STORE=database
FILESYSTEM_DISK=local

# --- E-mails (Resend) -------------------------------------------------------
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS="bonjour@souk.dev"
MAIL_FROM_NAME="${APP_NAME}"
# Alertes de l'admin (paiement en double, écart de rapprochement, copie qui ne repart pas).
# Vide : MAIL_FROM_ADDRESS.
ADMIN_EMAIL=

# --- Paiement (SasPay) ------------------------------------------------------
# Clé secrète, côté serveur seulement, jamais dans les journaux. Vide : simulateur de paiement.
SASPAY_SECRET_KEY=
# Secret de signature des webhooks (tableau de bord SasPay, affiché une seule fois).
SASPAY_WEBHOOK_SECRET=
SASPAY_BASE_URL=https://api.saspay.me/api/v1
# Passerelle d'encaissement : saspay (défaut si la clé est là) ou simulee (parcours réussis en
# développement : la clé fournie est sur un compte où les paiements échouent volontairement).
# Jamais simulee en production.
PAIEMENT_PASSERELLE=
# Les reversements aux devs passent par le simulateur tant que ceci n'est pas à true
# (un payout fait sortir de l'argent du compte et exige l'IP du serveur en liste blanche).
REVERSEMENTS_REELS=false
# Webhooks du simulateur : l'API vue depuis le worker (http://api:8000 dans docker-compose.yml).
SIMULATEUR_WEBHOOK_URL=

# --- Souk AI (DeepSeek, API compatible OpenAI) -------------------------------
# Vide en développement : fournisseur simulé (en production, la clé est obligatoire).
DEEPSEEK_API_KEY=
# Modèle courant : GET https://api.deepseek.com/models
DEEPSEEK_MODELE=deepseek-flash
# simulee force le fournisseur simulé (tests, travail hors ligne) ; refusé en production.
IA_FOURNISSEUR=deepseek

# --- SMS (connexion des utilisateurs finaux du backend intégré) ---------------
# Vides : fournisseur simulé.
SMS_PROVIDER=
SMS_API_KEY=

# --- Moteur de déploiement --------------------------------------------------
# URL publique d'une copie en ligne ; {copie} devient l'identifiant Compose.
MOTEUR_URL_COPIE="http://{copie}.localhost"
# Page « copie suspendue » (impayé) : l'API vue depuis Traefik (http://api:8000 en production).
MOTEUR_PAGE_SUSPENDUE=http://127.0.0.1:8000
# Secondes laissées à Traefik pour charger une route avant d'annoncer la copie en ligne.
MOTEUR_DELAI_PROXY=3
# Dossier des routes lues par Traefik (par défaut storage/app/private/proxy).
# MOTEUR_PROXY_ROUTES=/chemin/absolu/des/routes
# Image de la sonde du service web (conteneur jetable sur le réseau de la copie).
# MOTEUR_IMAGE_SONDE=curlimages/curl:8.11.1
