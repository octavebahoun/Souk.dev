# Laravel local : laisser vide, le proxy Vite (port 5173) transmet au port 8000.
# Pour utiliser Prism à la place : VITE_API_URL=http://127.0.0.1:4010
VITE_API_URL=

# Reverb. Ces quatre valeurs n'ont pas encore été données : les laisser vides.
# Le fil s'affiche quand même. Le bandeau « N nouvelles » reste inactif.
VITE_REVERB_HOST=
VITE_REVERB_PORT=
VITE_REVERB_KEY=
VITE_REVERB_SCHEME=
