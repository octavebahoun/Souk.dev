# Laisser vide : le proxy Vite (port 5173) transmet /api, /auth, /sanctum, /broadcasting
# et /storage à Laravel (http://localhost:8000, ou le conteneur « api » avec docker compose).
VITE_API_URL=

# Reverb (temps réel). Avec docker compose, ces valeurs sont fournies par le conteneur « front ».
# Vides : l'interface marche quand même, sans mise à jour en direct.
VITE_REVERB_HOST=
VITE_REVERB_PORT=
VITE_REVERB_KEY=
VITE_REVERB_SCHEME=
